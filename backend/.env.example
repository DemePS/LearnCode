# LearnCode backend configuration. Copy to .env (uvicorn/`python -m app` reads it) and fill in.
# Anything not listed here has a working default; see app/db.py, app/agent.py and app/auth.py.

# --- Sign-in with GitHub (Stage 4) -------------------------------------------------------------
# A GitHub *OAuth App* (Settings > Developer settings > OAuth Apps), not a GitHub App: an app
# installation token only sees the repositories the app is installed on. Request NO scopes -- identity
# and public repository search need none, and the app never asks for `repo`.
# The callback URL registered on the app must be: <LEARNCODE_BASE_URL>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# The origin the browser actually uses. In dev with the Vite proxy that is http://127.0.0.1:5173
# (not the backend's port: GitHub redirects the learner back to where the browser is). In production
# it is https://<your-domain> -- an https value also makes the session cookie Secure.
LEARNCODE_BASE_URL=http://127.0.0.1:5173

# Key that encrypts the stored GitHub tokens (Fernet). Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing it makes existing tokens unreadable -- the learners are simply treated as tokenless.
LEARNCODE_SECRET_KEY=

# Local development without registering an OAuth app: one fixed local user, no GitHub identity.
# It logs a loud warning at startup, and must never be used on a deployed server.
# LEARNCODE_AUTH=off

# --- Storage -----------------------------------------------------------------------------------
# The database holding accounts, learning sessions and every page. Defaults to
# sqlite:///<backend>/data/learncode.db; point it at Postgres to scale past one machine.
# LEARNCODE_DATABASE_URL=sqlite:///data/learncode.db

# --- Concurrency -------------------------------------------------------------------------------
# How many turns may run at once across all learners (app/agent.py's BoundedSemaphore). Each turn
# holds a worker thread, a model connection and possibly a git clone.
# LEARNCODE_MAX_CONCURRENT_TURNS=4

# --- Fallbacks, for a run without sign-in ------------------------------------------------------
# With LEARNCODE_AUTH=off (or a learner whose token could not be decrypted), GitHub is called
# anonymously unless one of these is set: 60 requests/hour per IP instead of 5,000.
# GITHUB_TOKEN=
